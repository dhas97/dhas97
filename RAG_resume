document.fonts.ready.then(function() {
  var tl = document.querySelector('.tl');
  if (!tl) return;
  var tlTop = tl.getBoundingClientRect().top;
  // d1=Summary, d2=Skills, d3=Certifications, d4=Work Experience, d5=Education
  var pairs = [['d1','s1'],['d2','s2'],['d3','s3'],['d4','s4'],['d5','s5']];
  pairs.forEach(function(pair) {
    var dot = document.getElementById(pair[0]);
    var sec = document.getElementById(pair[1]);
    if (!dot) return;
    if (!sec) { dot.style.display = 'none'; return; }
    var title = sec.querySelector('.sec-title') || sec;
    var titleRect = title.getBoundingClientRect();
    var topPos = titleRect.top - tlTop + (titleRect.height / 2) - 12;
    dot.style.top = Math.max(0, topPos) + 'px';
  });
});
</script>

